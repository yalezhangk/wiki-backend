# ============================================================================
# 共享仓库与路径
# ============================================================================
# 共享知识库所在的 llm-wiki-agent 仓库根目录；未设置时默认使用相邻目录。
WIKI_AGENT_REPO_PATH=../llm-wiki-agent

# ============================================================================
# MySQL 数据库
# ============================================================================
# MySQL 主机；生产环境必须保持为本机回环地址。
WIKI_BACKEND_MYSQL_HOST=127.0.0.1
# MySQL 端口。
WIKI_BACKEND_MYSQL_PORT=3306
# MySQL 应用账户名。
WIKI_BACKEND_MYSQL_USER=wiki_backend_app
# MySQL 应用账户密码；必须替换为真实密码，不能提交到 Git。
WIKI_BACKEND_MYSQL_PASSWORD=
# MySQL 数据库名。
WIKI_BACKEND_MYSQL_DATABASE=wiki_backend

# ============================================================================
# 聊天默认行为
# ============================================================================
# 新建聊天会话的默认标题。
WIKI_BACKEND_DEFAULT_CHAT_TITLE=新对话
# 聊天回答携带的最大历史消息数。
WIKI_BACKEND_CHAT_HISTORY_LIMIT=6

# ============================================================================
# 手动 Ingest 入库
# ============================================================================
# 单次上传允许的最大字节数。
WIKI_BACKEND_INGEST_MAX_UPLOAD_BYTES=10485760
# Ingest 主模型单次生成的最大 token 数；仅在确认模型支持后调整。
WIKI_BACKEND_INGEST_LLM_MAX_TOKENS=8192
# Ingest 专用模型提供方和模型名；只允许服务端白名单中的组合:deepseek、ollama_chat。
WIKI_BACKEND_INGEST_PROVIDER=deepseek
WIKI_BACKEND_INGEST_MODEL=deepseek-v4-pro
# Ingest 只接受完整机器可解析 JSON，DeepSeek 和本地 qwen3.6:35b 均固定关闭思考。
WIKI_BACKEND_INGEST_REASONING_EFFORT=none
# 是否启用可选的 Marker OCR；默认使用 RapidOCR + ONNX Runtime。
WIKI_BACKEND_INGEST_ENABLE_MARKER_OCR=false

# ============================================================================
# 定时 Ingest 入库
# ============================================================================
# 定时 Markdown 入库的受控源目录；仅运行 app.scheduled_ingest 时需要。
WIKI_BACKEND_SCHEDULED_INGEST_ROOT=/path/to/source-directory
# 定时入库回调本机 FastAPI 的地址；必须是 127.0.0.1。
WIKI_BACKEND_SCHEDULED_INGEST_API_URL=http://127.0.0.1:8081
# 定时入库轮询任务状态的间隔秒数。
WIKI_BACKEND_SCHEDULED_INGEST_POLL_SECONDS=2
# 定时入库等待单个任务完成的最长秒数。
WIKI_BACKEND_SCHEDULED_INGEST_POLL_TIMEOUT_SECONDS=7200

# ============================================================================
# Quartz 发布
# ============================================================================
# Quartz 仓库根目录；未设置时默认使用相邻目录。
WIKI_BACKEND_QUARTZ_REPO_PATH=../quartz
# Quartz 构建使用的 Node.js 可执行文件。
WIKI_BACKEND_PUBLISH_NODE_EXECUTABLE=node
# 单次 Quartz 构建允许的最长秒数。
WIKI_BACKEND_PUBLISH_BUILD_TIMEOUT_SECONDS=900
# 多次 Wiki 变更合并为一次发布前的等待秒数。
WIKI_BACKEND_PUBLISH_DEBOUNCE_SECONDS=120
# 发布任务允许延后的最长秒数。
WIKI_BACKEND_PUBLISH_MAX_DELAY_SECONDS=600

# ============================================================================
# 质量报告
# ============================================================================
# 质量报告超过该天数后标记为过期。
WIKI_BACKEND_QUALITY_STALE_AFTER_DAYS=90

# ============================================================================
# 内部 LLM 任务
# ============================================================================
# 内部任务（检索、入库、巡检）使用的 LiteLLM provider,包括：deepseek、ollama_chat
WIKI_BACKEND_LLM_PROVIDER=deepseek
# 内部轻量任务使用的模型名。
WIKI_BACKEND_LLM_FAST_MODEL=deepseek-v4-flash
# 内部主任务使用的模型名。
WIKI_BACKEND_LLM_MAIN_MODEL=deepseek-v4-pro
# 内部轻量任务单次生成的最大 token 数。
WIKI_BACKEND_LLM_FAST_MAX_TOKENS=5120
# 内部主任务单次生成的最大 token 数。
WIKI_BACKEND_LLM_MAIN_MAX_TOKENS=8192
# 内部轻量任务的采样温度。
WIKI_BACKEND_LLM_FAST_TEMPERATURE=0.0
# 内部主任务的采样温度。
WIKI_BACKEND_LLM_MAIN_TEMPERATURE=0.2

# ============================================================================
# LLM 服务连接与凭据
# ============================================================================
# DeepSeek 连接的 API Key；聊天档案和内部 DeepSeek 任务共用，不能提交到 Git。
WIKI_BACKEND_DEEPSEEK_API_KEY=
# DeepSeek OpenAI 兼容 API 根地址；通常保持官方默认值即可。
WIKI_BACKEND_DEEPSEEK_API_BASE=https://api.deepseek.com
# 同机 Ollama API 根地址；不得暴露给浏览器、局域网或公网。
WIKI_BACKEND_OLLAMA_API_BASE=http://127.0.0.1:11434

# ============================================================================
# 聊天模型档案
# ============================================================================
# 新消息默认使用的回答模型档案 ID；必须同时出现在已启用档案列表中。
WIKI_BACKEND_MODEL_PROFILE_DEFAULT_ID=deepseek-v4-flash
# 向浏览器公开的回答模型档案 ID，使用逗号分隔；未列出即禁用。
WIKI_BACKEND_MODEL_PROFILE_ENABLED_IDS=deepseek-v4-pro,deepseek-v4-flash,local-qwen3.6-35b-direct,local-qwen3.6-35b-thinking
